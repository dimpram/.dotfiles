#!/bin/sh

# 1. Check for arguments
if [ "$#" -ne 2 ]; then
    echo "Error: Missing arguments."
    echo "Usage: ./rawprint <path_to_photo.jpg> <printer_ip>"
    exit 1
fi

INPUT_FILE="$1"
PRINTER_IP="$2"
PRINTER_PORT="9100"
PREVIEW_FILE="/tmp/print_preview_10x15.jpg"

echo "--- 10x15 cm Print Setup ---"
echo "1) Standard (300 DPI) - Best for normal photos"
echo "2) High Detail (600 DPI) - Best for preserving film grain"
read -p "Select quality [Default is 1]: " QUALITY_CHOICE

# 2. Set the exact pixel math based on the choice
if [ "$QUALITY_CHOICE" == "2" ]; then
    WIDTH="2362"
    HEIGHT="3543"
    DENSITY="600"
    echo "Using High Detail (600 DPI)..."
else
    WIDTH="1181"
    HEIGHT="1772"
    DENSITY="300"
    echo "Using Standard Detail (300 DPI)..."
fi

echo "Formatting '$INPUT_FILE' for a 10x15 cm raw layout..."

# 3. Process the image dynamically
convert "$INPUT_FILE" -resize ${WIDTH}x${HEIGHT}^ -gravity center -extent ${WIDTH}x${HEIGHT} -density $DENSITY -units PixelsPerInch "$PREVIEW_FILE"

echo "Opening preview..."

# 4. Open the image
xdg-open "$PREVIEW_FILE" 2>/dev/null &

# 5. Wait for user confirmation
echo ""
echo "WARNING: You are sending raw data to $PRINTER_IP. Make sure 'Matte' is selected on the printer screen!"
read -p "Does the crop look good? Print now? (y/n): " confirm

if [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "Sending raw JPG directly to $PRINTER_IP on port $PRINTER_PORT..."
    
    # 6. Print using ncat
    ncat "$PRINTER_IP" "$PRINTER_PORT" < "$PREVIEW_FILE"
    
    echo "Job sent! Check the printer."
else
    echo "Print cancelled. The preview file is saved at $PREVIEW_FILE."
fi
