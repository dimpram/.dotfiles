#!/usr/bin/env bash

# Exit immediately if a command fails
set -e 

echo "=> Starting X230 Minimalist Setup..."

# Request root access upfront
sudo -v

# Define required packages
PACKAGES=(
    nvim base-devel wayland wlroots wayland-protocols pango libxkbcommon libinput wl-clipboard
    pipewire pipewire-pulse wireplumber
    mako libnotify bemenu-wayland
    lf ttf-jetbrains-mono
)

echo "=> Installing system packages..."
sudo pacman -Syu --needed --noconfirm "${PACKAGES[@]}"

echo "=> Enabling PipeWire audio services for the current user..."
systemctl --user enable --now pipewire pipewire-pulse wireplumber

DWL_REPO="https://github.com/dimpram/dwl.git"
DWL_DIR="$HOME/.local/src/dwl"

echo "=> Preparing dwl from $DWL_REPO..."
if [ ! -d "$DWL_DIR" ]; then
    # Create parent directory to prevent clone errors
    mkdir -p "$HOME/.local/src"
    git clone "$DWL_REPO" "$DWL_DIR"
else
    echo "=> Directory exists, pulling latest changes..."
    cd "$DWL_DIR"
    git pull
fi

echo "=> Compiling and installing dwl..."
cd "$DWL_DIR"
sudo make clean install

DOTFILES_REPO="git@github.com:mrjones2014/dotfiles.git"
DOTFILES_DIR="$HOME/.dotfiles"
BACKUP_DIR="$HOME/.dotfiles-backup"

echo "=> Cloning dotfiles from $DOTFILES_REPO..."
if [ ! -d "$DOTFILES_DIR" ]; then
    cd "$HOME"
    git clone --bare "$DOTFILES_REPO" "$DOTFILES_DIR"
else
    echo "=> Dotfiles repository already exists, skipping clone."
fi

# Define local dotfiles alias
function config {
   git --git-dir="$DOTFILES_DIR/" --work-tree="$HOME" "$@"
}

echo "=> Creating backup directory at $BACKUP_DIR..."
mkdir -p "$BACKUP_DIR"

echo "=> Attempting to checkout dotfiles..."
set +e
config checkout
CHECKOUT_STATUS=$?
set -e

if [ $CHECKOUT_STATUS = 0 ]; then
    echo "=> Checked out dotfiles successfully."
else
    echo "=> Conflicts detected, moving existing dotfiles to backup..."
    
    # Parse conflicts and safely back them up
    config checkout 2>&1 | grep -E "\s+\." | awk '{print $1}' | while read -r file; do
        mkdir -p "$BACKUP_DIR/$(dirname "$file")"
        mv "$HOME/$file" "$BACKUP_DIR/$file"
        echo "=> Backed up: $file"
    done

    echo "=> Retrying checkout..."
    config checkout
fi

echo "=> Hiding untracked files in dotfiles status..."
config config status.showUntrackedFiles no

echo "=> Setup complete."
